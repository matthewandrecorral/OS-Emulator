{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run OS-Emulator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/OS-Emulator",
      "windows": {
        "program": "${workspaceFolder}/build/OS-Emulator.exe",
        "MIMode": "gdb"
      },
      "osx": {
        "MIMode": "lldb"
      },
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "preLaunchTask": "CMake: build"
    }
  ]
}